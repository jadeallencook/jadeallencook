import appleLogo from '../assets/logos/apple.png';
import clearLogo from '../assets/logos/clear.png';
import deseretNewsLogo from '../assets/logos/deseret-news.png';
import googleLogo from '../assets/logos/google.png';
import playstationLogo from '../assets/logos/playstation.png';
import waveorthoLogo from '../assets/logos/waveortho.png';
import ButtonLink from '../components/button-link.astro';
import { ExperienceAccordion } from '../components/experience-accordion';
import Header from '../components/header.astro';
import LogoList from '../components/logo-list.astro';
import { primaryCtas, resumeLink } from '../components/nav-links';
