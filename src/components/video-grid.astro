---
import YouTubeVideo from './youtube-video.astro';

interface Video {
  id: string;
  title: string;
}

interface Props {
  videos: Video[];
}

const { videos } = Astro.props;
---

<ul class="grid list-none grid-cols-2 gap-4 p-0 max-sm:grid-cols-1">
  {
    videos.map(({ id, title }) => (
      <li class="flex flex-col gap-2">
        <YouTubeVideo id={id} title={title} />
      </li>
    ))
  }
</ul>
