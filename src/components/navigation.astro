---
import ButtonLink from './button-link.astro';
import { DesktopNavMenu } from './desktop-nav-menu';
import { MobileNavAccordion } from './mobile-nav-accordion';
---

<nav aria-label="Site" class="border-b border-border">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
    <a href="/" class="shrink-0 font-bold text-foreground">Jade Allen Cook</a>

    <div class="hidden lg:flex">
      <DesktopNavMenu client:load />
    </div>

    <div class="hidden items-center lg:flex">
      <ButtonLink href="https://calendly.com/jadeallencook/recruit" external>
        Book a Call
      </ButtonLink>
      <ButtonLink
        href="https://docs.google.com/document/d/1u_Nt4nNpvNyrSYuzycSSUmB2mbTVSvcCB64o1D4Vkxg"
        external
        isSecondary
        class="me-0"
      >
        Download My Resume
      </ButtonLink>
    </div>

    <button
      type="button"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="nav-mobile-panel"
      class="inline-flex items-center justify-center rounded-md border border-border p-2 text-foreground lg:hidden"
    >
      <span class="sr-only">Toggle menu</span>
      <svg
        id="nav-toggle-menu-icon"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        class="size-5"
      >
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
      <svg
        id="nav-toggle-close-icon"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        class="hidden size-5"
      >
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <div
    id="nav-mobile-panel"
    class="flex flex-col gap-4 border-t border-border px-4 py-4 sm:px-6 lg:hidden"
    hidden
  >
    <MobileNavAccordion client:load />
    <div class="flex flex-col gap-2">
      <ButtonLink
        href="https://calendly.com/jadeallencook/recruit"
        external
        class="me-0 w-full text-center"
      >
        Book a Call
      </ButtonLink>
      <ButtonLink
        href="https://docs.google.com/document/d/1u_Nt4nNpvNyrSYuzycSSUmB2mbTVSvcCB64o1D4Vkxg"
        external
        isSecondary
        class="me-0 w-full text-center"
      >
        Download My Resume
      </ButtonLink>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-mobile-panel');
  const menuIcon = document.getElementById('nav-toggle-menu-icon');
  const closeIcon = document.getElementById('nav-toggle-close-icon');

  toggle?.addEventListener('click', () => {
    const opening = panel?.hidden;
    if (panel) panel.hidden = !opening;
    toggle.setAttribute('aria-expanded', String(!!opening));
    menuIcon?.classList.toggle('hidden', !!opening);
    closeIcon?.classList.toggle('hidden', !opening);
  });
</script>
