---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface LogoItem {
  name: string;
  src: ImageMetadata;
}

interface Props {
  logos: LogoItem[];
}

const { logos } = Astro.props;
---

<ul class="mt-6 grid list-none grid-cols-2 gap-4 p-0 sm:grid-cols-3 lg:grid-cols-6">
  {
    logos.map(({ name, src }) => (
      <li>
        <div class="flex h-full flex-col items-center gap-3 rounded-xl border border-border bg-card p-6 shadow-sm">
          <Image
            src={src}
            alt=""
            width={96}
            class="h-12 w-full object-contain dark:invert"
          />
          <span class="text-center text-sm font-medium text-muted-foreground">
            {name}
          </span>
        </div>
      </li>
    ))
  }
</ul>
