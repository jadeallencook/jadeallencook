---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface LogoItem {
  name: string;
  src: ImageMetadata;
}

interface Props {
  logos: LogoItem[];
}

const { logos } = Astro.props;
const count = logos.length;
const colsMd = Math.ceil(count / 2);
const colsSm = Math.ceil(count / 3);
---

<ul
  class="logo-list mt-4 grid w-full list-none gap-6 p-0"
  style={`--cols: repeat(${count}, 1fr); --cols-md: repeat(${colsMd}, 1fr); --cols-sm: repeat(${colsSm}, 1fr)`}
>
  {
    logos.map(({ name, src }) => (
      <li class="flex flex-col items-center gap-2">
        <Image
          src={src}
          alt=""
          width={80}
          class="h-10 w-full max-w-20 object-contain dark:invert"
        />
        <span class="text-center text-xs text-muted-foreground">{name}</span>
      </li>
    ))
  }
</ul>

<style>
  .logo-list {
    grid-template-columns: var(--cols);
  }

  @media (max-width: 600px) {
    .logo-list {
      grid-template-columns: var(--cols-md);
    }
  }

  @media (max-width: 380px) {
    .logo-list {
      grid-template-columns: var(--cols-sm);
    }
  }
</style>
