---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface LogoItem {
  name: string;
  src: ImageMetadata;
}

interface Props {
  logos: LogoItem[];
}

const { logos } = Astro.props;
const count = logos.length;
const colsMd = Math.ceil(count / 2);
const colsSm = Math.ceil(count / 3);
---

<ul
  class="logo-list"
  style={`--cols: repeat(${count}, 1fr); --cols-md: repeat(${colsMd}, 1fr); --cols-sm: repeat(${colsSm}, 1fr)`}
>
  {
    logos.map(({ name, src }) => (
      <li>
        <Image src={src} alt="" width={80} />
        <span>{name}</span>
      </li>
    ))
  }
</ul>

<style>
  .logo-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: var(--cols);
    gap: 24px;
    width: 100%;
    margin-block-start: var(--space-block);
  }

  @media (max-width: 600px) {
    .logo-list {
      grid-template-columns: var(--cols-md);
    }
  }

  @media (max-width: 380px) {
    .logo-list {
      grid-template-columns: var(--cols-sm);
    }
  }

  li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  img {
    width: 100%;
    max-width: 80px;
    height: 40px;
    object-fit: contain;
  }

  span {
    font-size: 0.75rem;
    text-align: center;
    color: var(--color-muted);
  }

  @media (prefers-color-scheme: dark) {
    img {
      filter: invert(1);
    }
  }
</style>
