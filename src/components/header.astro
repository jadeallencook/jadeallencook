---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Eyebrow from './eyebrow.astro';

interface Props {
  heading: string;
  eyebrow: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imageCaption?: string;
  imageWidth?: number;
}

const {
  heading,
  eyebrow,
  image,
  imageAlt = '',
  imageCaption,
  imageWidth = 1200,
} = Astro.props;
---

<header class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">
  <div class="flex flex-col gap-4">
    <h1 class="text-balance text-4xl font-extrabold tracking-tight lg:text-5xl">
      {heading}
    </h1>
    <Eyebrow>{eyebrow}</Eyebrow>
    <slot />
  </div>
  {
    image && (
      <div class="rounded-xl border border-border bg-card p-2 shadow-sm">
        <Image
          src={image}
          alt={imageAlt}
          width={imageWidth}
          class="h-auto w-full rounded-lg"
        />
        {imageCaption && (
          <p class="mt-2 px-1 pb-1 text-center text-sm text-muted-foreground">
            {imageCaption}
          </p>
        )}
      </div>
    )
  }
</header>
