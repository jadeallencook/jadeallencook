---
import { buttonVariants } from './ui/button';
import { cn } from '../lib/utils';

interface Props {
  href: string;
  external?: boolean;
  isSecondary?: boolean;
  class?: string;
}

const {
  href,
  external = false,
  isSecondary = false,
  class: className,
} = Astro.props;
const externalProps = external
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<a
  href={href}
  {...externalProps}
  class={cn(
    buttonVariants({ variant: isSecondary ? 'outline' : 'default' }),
    'me-2 w-fit max-sm:mt-4 max-sm:flex max-sm:w-full',
    className
  )}
>
  <slot />
</a>
