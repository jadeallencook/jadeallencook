---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Eyebrow from './eyebrow.astro';

interface Props {
  id: string;
  heading: string;
  eyebrow: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imageWidth?: number;
}

const {
  id,
  heading,
  eyebrow,
  image,
  imageAlt = '',
  imageWidth = 900,
} = Astro.props;
---

<section aria-labelledby={id} class="flex flex-col gap-4">
  <h2 id={id} class="text-balance text-3xl font-semibold tracking-tight">
    {heading}
  </h2>
  <Eyebrow>{eyebrow}</Eyebrow>
  <div class="space-y-4">
    {
      image && (
        <div class="mb-4 w-full rounded-xl border border-border bg-card p-2 shadow-sm sm:float-right sm:mb-4 sm:ml-6 sm:w-[45%]">
          <Image
            src={image}
            alt={imageAlt}
            width={imageWidth}
            class="h-auto w-full rounded-lg"
          />
        </div>
      )
    }
    <slot />
  </div>
</section>
