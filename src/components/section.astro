---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Eyebrow from './eyebrow.astro';

interface Props {
  id: string;
  heading: string;
  eyebrow: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imageWidth?: number;
}

const {
  id,
  heading,
  eyebrow,
  image,
  imageAlt = '',
  imageWidth = 1000,
} = Astro.props;
---

<section aria-labelledby={id} class="flex flex-col gap-4">
  <h2 id={id} class="text-balance text-3xl font-semibold tracking-tight">
    {heading}
  </h2>
  <Eyebrow>{eyebrow}</Eyebrow>
  {
    image && (
      <Image
        src={image}
        alt={imageAlt}
        width={imageWidth}
        class="h-auto w-full rounded-lg"
      />
    )
  }
  <slot />
</section>
