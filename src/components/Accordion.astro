---
interface Props {
  summary: string;
}

const { summary } = Astro.props;
---

<details>
  <summary>
    <h3>{summary}</h3>
    <span aria-hidden="true" class="icon"></span>
  </summary>
  <div class="body">
    <slot />
  </div>
</details>

<style>
  details {
    border-block-end: 1px solid currentColor;
    opacity: 0.9;
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 0.875rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    text-wrap: balance;
  }

  .icon {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    position: relative;
  }

  .icon::before,
  .icon::after {
    content: '';
    position: absolute;
    background: currentColor;
    border-radius: 2px;
    inset-block-start: 50%;
    inset-inline-start: 0;
    width: 100%;
    height: 2px;
    transform: translateY(-50%);
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .icon::after {
    transform: translateY(-50%) rotate(90deg);
  }

  details[open] .icon::after {
    transform: translateY(-50%) rotate(0deg);
    opacity: 0;
  }

  .body {
    padding-block-end: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .body :global(p) {
    margin: 0;
  }
</style>
